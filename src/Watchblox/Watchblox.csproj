<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Watchblox</AssemblyName>
    <RootNamespace>Watchblox</RootNamespace>
    <Version>1.5.6</Version>
    <Product>Watchblox</Product>
    <Description>Watchblox - Roblox friend and presence companion</Description>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- WFAC010 is suppressed, not ignored: the DPI settings live in
         app.manifest because a custom manifest is required, and
         ApplicationHighDpiMode is only an analyzer-visible property —
         with a custom manifest it changes nothing in the built exe
         (verified on the Toolkit: no dpiAware in the binary without
         the manifest entries). The manifest is the only route that
         actually applies. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
