<Window x:Class="Watchblox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Watchblox" Height="660" Width="940"
        MinHeight="540" MinWidth="780"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FriendRowTemplate">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="12"
                    Margin="0,0,0,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Presence spine: the card's own color signature. -->
                    <Rectangle Grid.Column="0" Fill="{Binding StatusColor}"
                               RadiusX="2.5" RadiusY="2.5" Margin="0,4,0,4"/>
                    <Grid Grid.Column="1" Width="52" Height="52">
                        <Ellipse Fill="{StaticResource Surface2Brush}"/>
                        <TextBlock Text="{Binding AvatarLetter}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasAvatar, Converter={StaticResource InverseBoolToVis}}"/>
                        <Image Source="{Binding AvatarPath}"
                               Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVis}}">
                            <Image.Clip>
                                <EllipseGeometry Center="26,26" RadiusX="26" RadiusY="26"/>
                            </Image.Clip>
                        </Image>
                        <Ellipse Width="14" Height="14" Fill="{Binding StatusColor}"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1"/>
                    </Grid>
                    <StackPanel Grid.Column="2" Margin="12,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text=" ✓" FontSize="13" Foreground="{StaticResource AccentBrush}"
                                       Visibility="{Binding Verified, Converter={StaticResource BoolToVis}}"
                                       VerticalAlignment="Center"/>
                            <Border Background="#3d2222" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                    Visibility="{Binding IsWatchlist, Converter={StaticResource BoolToVis}}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="WATCHLIST" FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextDimBrush}">
                            <Run Text="@"/><Run Text="{Binding Username}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding GameLine}" FontSize="13"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"
                                   Visibility="{Binding GameLineVisible, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="13"
                                   Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0"
                                   Visibility="{Binding GameLineVisible, Converter={StaticResource InverseBoolToVis}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Join" Style="{StaticResource PrimaryButton}" Padding="18,8"
                                Visibility="{Binding ShowJoin, Converter={StaticResource BoolToVis}}"
                                Click="JoinButton_Click" Tag="{Binding}" Margin="0,0,6,0"/>
                        <Button Content="✕" Style="{StaticResource GhostButton}" Padding="10,8"
                                Visibility="{Binding IsWatchlist, Converter={StaticResource BoolToVis}}"
                                Click="RemoveWatch_Click" Tag="{Binding}" ToolTip="Remove from watchlist"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ActivityRowTemplate">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="12,10"
                    Margin="0,0,0,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="10" Height="10" Fill="{Binding KindColor}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="14"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center">
                        <Run Text="{Binding DisplayName}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{Binding Text}"/>
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="12"
                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- ==================== ONBOARDING ==================== -->
        <Grid x:Name="OnboardingView" Background="{StaticResource BgBrush}">
            <Border Width="440" Padding="36,32" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Watchblox" FontFamily="{StaticResource MinecraftTitle}"
                               FontSize="36" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Know when your friends play." FontSize="14"
                               Foreground="{StaticResource TextDimBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,24"/>
                    <TextBlock Text="Enter your Roblox username:" FontSize="14"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OnboardUsername" KeyDown="OnboardUsername_KeyDown"/>
                        <Button Grid.Column="1" Content="Find" Style="{StaticResource PrimaryButton}"
                                Margin="8,0,0,0" Click="OnboardFind_Click" x:Name="OnboardFindBtn"/>
                    </Grid>
                    <TextBlock x:Name="OnboardError" Foreground="#f87171" FontSize="13"
                               TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <Border x:Name="OnboardResult" Visibility="Collapsed" Margin="0,16,0,0"
                            Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="48" Height="48">
                                    <Ellipse Fill="{StaticResource BorderBrush}"/>
                                    <Image x:Name="OnboardAvatar">
                                        <Image.Clip>
                                            <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24"/>
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="OnboardDisplayName" FontSize="16"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock x:Name="OnboardVerified" Text=" ✓" FontSize="13"
                                                   Foreground="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <TextBlock x:Name="OnboardUsernameLabel" FontSize="13"
                                               Foreground="{StaticResource TextDimBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Content="Start watching" Style="{StaticResource PrimaryButton}"
                                    Margin="0,14,0,0" Click="OnboardStart_Click"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="No login needed — Watchblox only reads public data."
                               FontSize="12" Foreground="{StaticResource TextDimBrush}"
                               HorizontalAlignment="Center" Margin="0,20,0,0" TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== MAIN ==================== -->
        <Grid x:Name="MainView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Watchblox" FontFamily="{StaticResource MinecraftTitle}"
                               FontSize="24" Foreground="{StaticResource AccentBrush}"
                               Margin="18,18,18,6"/>
                    <Border Grid.Row="1" Margin="12,6,12,12" Background="{StaticResource Surface2Brush}"
                            CornerRadius="12" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="44" Height="44">
                                <Ellipse Fill="{StaticResource BorderBrush}"/>
                                <TextBlock x:Name="SideAvatarLetter" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="SideAvatar" Visibility="Collapsed">
                                    <Image.Clip>
                                        <EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22"/>
                                    </Image.Clip>
                                </Image>
                            </Grid>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SideUserName" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource TextBrush}" TextWrapping="NoWrap"/>
                                <TextBlock x:Name="SideUserSub" FontSize="12"
                                           Foreground="{StaticResource TextDimBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="8,0">
                        <Button x:Name="NavFriends" Content="Friends" Style="{StaticResource NavButton}"
                                Click="Nav_Click" Tag="Active"/>
                        <Button x:Name="NavActivity" Content="Activity" Style="{StaticResource NavButton}"
                                Click="Nav_Click" Tag=""/>
                        <Button x:Name="NavWatchlist" Content="Watchlist" Style="{StaticResource NavButton}"
                                Click="Nav_Click" Tag=""/>
                        <Button x:Name="NavSettings" Content="Settings" Style="{StaticResource NavButton}"
                                Click="Nav_Click" Tag=""/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Margin="18,12">
                        <Button x:Name="UpdateButton" Content="Update available — install"
                                Style="{StaticResource PrimaryButton}" FontSize="12" Padding="10,8"
                                Visibility="Collapsed" Click="UpdateButton_Click" Margin="0,0,0,8"/>
                        <TextBlock x:Name="VersionText" FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Friends page -->
                <Grid x:Name="FriendsPage" Margin="22,18,22,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Friends" FontFamily="{StaticResource MinecraftTitle}"
                               FontSize="28" Foreground="{StaticResource TextBrush}"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,14">
                        <TextBox x:Name="FriendSearch" Width="250" Margin="0,0,10,0"
                                 ToolTip="Search friends" TextChanged="FriendSearch_TextChanged"/>
                        <Button Content="All" Style="{StaticResource GhostButton}" Padding="14,8"
                                Margin="0,0,6,0" Click="FilterChip_Click" Tag="All" x:Name="ChipAll"/>
                        <Button Content="Online" Style="{StaticResource GhostButton}" Padding="14,8"
                                Margin="0,0,6,0" Click="FilterChip_Click" Tag="Online" x:Name="ChipOnline"/>
                        <Button Content="In Game" Style="{StaticResource GhostButton}" Padding="14,8"
                                Margin="0,0,6,0" Click="FilterChip_Click" Tag="InGame" x:Name="ChipInGame"/>
                        <Button Content="Offline" Style="{StaticResource GhostButton}" Padding="14,8"
                                Click="FilterChip_Click" Tag="Offline" x:Name="ChipOffline"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="FriendsList" ItemTemplate="{StaticResource FriendRowTemplate}"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <TextBlock x:Name="FriendsEmpty" Text="No friends match."
                                   Foreground="{StaticResource TextDimBrush}" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Grid>

                <!-- Activity page -->
                <Grid x:Name="ActivityPage" Margin="22,18,22,12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Activity" FontFamily="{StaticResource MinecraftTitle}"
                                   FontSize="28" Foreground="{StaticResource TextBrush}"/>
                        <Button Grid.Column="1" Content="Clear" Style="{StaticResource GhostButton}"
                                Padding="14,8" Click="ClearActivity_Click" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <ListBox x:Name="ActivityList" ItemTemplate="{StaticResource ActivityRowTemplate}"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <TextBlock x:Name="ActivityEmpty"
                                   Text="Nothing yet — it'll show up here when friends come and go."
                                   Foreground="{StaticResource TextDimBrush}" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" Padding="40,0"/>
                    </Grid>
                </Grid>

                <!-- Watchlist page -->
                <Grid x:Name="WatchlistPage" Margin="22,18,22,12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Watchlist" FontFamily="{StaticResource MinecraftTitle}"
                               FontSize="28" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Grid.Row="0" Text="Track anyone by username — even non-friends."
                               Foreground="{StaticResource TextDimBrush}" FontSize="13"
                               Margin="0,36,0,0"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,14">
                        <TextBox x:Name="WatchUsername" Width="250" Margin="0,0,10,0"
                                 ToolTip="Roblox username" KeyDown="WatchUsername_KeyDown"/>
                        <Button Content="Add" Style="{StaticResource PrimaryButton}"
                                Padding="18,8" Click="WatchAdd_Click"/>
                        <TextBlock x:Name="WatchError" Foreground="#f87171" FontSize="13"
                                   VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <ListBox x:Name="WatchListBox" Grid.Row="2"
                             ItemTemplate="{StaticResource FriendRowTemplate}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>

                <!-- Settings page -->
                <ScrollViewer x:Name="SettingsPage" Margin="22,18,22,12" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Text="Settings" FontFamily="{StaticResource MinecraftTitle}"
                                   FontSize="28" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>

                        <TextBlock Text="Presence checks" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="PollCombo" Width="220" HorizontalAlignment="Left"
                                  Margin="0,6,0,4" SelectionChanged="PollCombo_Changed">
                            <ComboBoxItem Content="Every 30 seconds" Tag="30"/>
                            <ComboBoxItem Content="Every 60 seconds" Tag="60"/>
                            <ComboBoxItem Content="Every 2 minutes" Tag="120"/>
                        </ComboBox>
                        <TextBlock Text="Faster checks use more requests." FontSize="12"
                                   Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,12"/>

                        <CheckBox x:Name="ToastCheck" Content="Toast notifications"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="StartWinCheck" Content="Start with Windows"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="UpdateCheckBox" Content="Check for updates on launch"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="AutoUpdateCheckBox" Content="Install updates automatically"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="TrayCheck" Content="Minimize to tray when closing"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>

                        <TextBlock Text="Interface scale" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,16,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="ScaleSlider" Width="220" Minimum="80" Maximum="150"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="ScaleSlider_Changed" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ScaleLabel" FontSize="13"
                                       Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="Updates" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,20,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Check for updates" Style="{StaticResource GhostButton}"
                                    Padding="14,8" Click="CheckUpdates_Click"/>
                            <TextBlock x:Name="UpdateStatus" FontSize="13"
                                       Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Text="Tracked account" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,20,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TrackedLabel" FontSize="13"
                                       Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="Switch account" Style="{StaticResource GhostButton}"
                                    Padding="14,8" Click="SwitchAccount_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Status bar -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                        Padding="16,8">
                    <TextBlock x:Name="StatusText" FontSize="12"
                               Foreground="{StaticResource TextDimBrush}"
                               Text="Starting…"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
