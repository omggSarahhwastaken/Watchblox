<Window x:Class="Watchblox.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile" Width="480" Height="600"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,6,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent"/>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="GroupRowTemplate">
            <StackPanel Margin="0,7">
                <TextBlock Text="{Binding GroupName}" FontSize="15"
                           Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                <TextBlock FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0">
                    <Run Text="{Binding RoleName}"/><Run Text="  •  "/><Run Text="{Binding MemberCountText}"/>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20,18,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="88" Height="88">
                <Ellipse Fill="{StaticResource Surface2Brush}"/>
                <TextBlock x:Name="ProfileLetter" Text="?" FontSize="34"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse x:Name="ProfileAvatar" Visibility="Collapsed">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="ProfileAvatarBrush" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
            <StackPanel Grid.Column="1" Margin="14,2,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="ProfileName" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="ProfileUser" FontSize="13"
                           Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0"/>
                <TextBlock x:Name="ProfileBadge" FontSize="12" Foreground="{StaticResource AccentBrush}"
                           Margin="0,2,0,0" Visibility="Collapsed" Text="✓ Verified"/>
                <TextBlock x:Name="ProfileStatus" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- tabs -->
        <TabControl Grid.Row="1" Margin="0,10,0,0">
            <TabItem Header="Info">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,6,0">
                    <StackPanel>
                        <TextBlock Text="About" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="ProfileBio" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Details" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                   Margin="0,18,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Joined" Foreground="{StaticResource TextDimBrush}" FontSize="13" Margin="0,0,0,8"/>
                            <TextBlock x:Name="ProfileJoined" Grid.Column="1" FontSize="13"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="User ID" Grid.Row="1" Foreground="{StaticResource TextDimBrush}" FontSize="13" Margin="0,0,0,8"/>
                            <TextBlock x:Name="ProfileId" Grid.Row="1" Grid.Column="1" FontSize="13"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="Network connections" Grid.Row="2" Foreground="{StaticResource TextDimBrush}" FontSize="13" Margin="0,0,0,8"/>
                            <TextBlock x:Name="ProfileConns" Grid.Row="2" Grid.Column="1" FontSize="13"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="Playing" Grid.Row="3" Foreground="{StaticResource TextDimBrush}" FontSize="13"/>
                            <TextBlock x:Name="ProfileGame" Grid.Row="3" Grid.Column="1" FontSize="13"
                                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                        </Grid>
                        <Button x:Name="ProfileJoinBtn" Content="Join server"
                                Style="{StaticResource PrimaryButton}" Visibility="Collapsed"
                                Padding="16,8" HorizontalAlignment="Left" Margin="0,14,0,0"
                                Click="ProfileJoin_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Groups">
                <Grid Margin="0,10,0,0">
                    <TextBlock x:Name="GroupsLoading" Text="Loading groups…"
                               Foreground="{StaticResource TextDimBrush}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GroupsEmpty" Text="No public groups."
                               Foreground="{StaticResource TextDimBrush}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                    <ListBox x:Name="GroupsList" ItemTemplate="{StaticResource GroupRowTemplate}"
                             HorizontalContentAlignment="Stretch" Visibility="Collapsed"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
